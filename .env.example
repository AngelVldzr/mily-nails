# Copia este archivo como .env.local para desarrollo
# y agrega las mismas variables en Vercel → Settings → Environment Variables
# ⚠️ NUNCA subas .env.local a GitHub (ya está bloqueado en .gitignore)

# Supabase → Project Settings → API
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=pega-aqui-la-service-role-key   # ¡secreta! da acceso total a la base de datos

# Contraseña del panel de Mily (/panel) — mínimo 10 caracteres, mejor una frase:
#   ej. "Lima-Rosa-Brillo-2026!"
ADMIN_PASSWORD=

# Cadena aleatoria de mínimo 32 caracteres (distinta a la contraseña). Genérala con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Cambiarla cierra todas las sesiones abiertas del panel.
ADMIN_SECRET=
